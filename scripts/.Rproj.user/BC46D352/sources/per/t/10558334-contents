mat <- as.matrix(read.csv("C:/Users/IsLoy_Ang/Desktop/math/tree3.csv", row.names = 1))
mat[mat != 0] <- 1  

orig_phy <- phyDat(mat, type = "USER", levels = c(0, 1))
orig_tree <- NJ(dist.hamming(orig_phy))

paper_tree <- read.tree(text = "((Gm,Gt),((XLZ7,(ZMS24,NDM8)),(Gd,(Tanguis,(Xinhai21,(Hai7124,(Pima90,3-79)))))));")

mast_size <- function(tree1, tree2) {
  tryCatch({
    m <- mast(tree1, tree2)
    length(m$tip.label)
  }, error = function(e) NA)
}

add_noise <- function(mat, n) {
  zeros <- which(mat == 0)
  if (length(zeros) == 0) return(mat)
  n <- min(n, length(zeros))
  mat[sample(zeros, n)] <- 1
  return(mat)
}

set.seed(42)
noise_levels <- seq(0, sum(mat == 0), by = 30)
n_reps <- 10
mast_data <- data.frame()

for (noise_n in noise_levels) {
  for (rep in 1:n_reps) {
    noisy_mat <- add_noise(mat, noise_n)
    noisy_phy <- phyDat(noisy_mat, type = "USER", levels = c(0, 1))
    noisy_tree <- NJ(dist.hamming(noisy_phy))
    common_tips <- intersect(noisy_tree$tip.label, orig_tree$tip.label)
    if (length(common_tips) >= 4) {
      mast_result <- mast_size(keep.tip(noisy_tree, common_tips), keep.tip(orig_tree, common_tips))
      mast_data <- rbind(mast_data, data.frame(rep = rep, mast = mast_result, replaced = noise_n))
    }
  }
  cat("Finished", noise_n, "changes\n")
}

