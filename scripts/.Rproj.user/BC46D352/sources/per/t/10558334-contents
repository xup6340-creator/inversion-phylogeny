library(ape)
library(phangorn)

matrix <- as.matrix(read.csv("C:/Users/IsLoy_Ang/Desktop/math/tree3.csv", row.names = 1))
matrix[is.na(matrix)] <- 0

data_phy <- phyDat(matrix, type = "USER", levels = c(0, 1))
tree_data <- NJ(dist.hamming(data_phy))
tree_data <- midpoint(tree_data)

safe_mast_size <- function(tree1, tree2) {
  tryCatch({
    m <- mast(tree1, tree2)
    length(m$tip.label)
  }, error = function(e) {
    return(NA)
  })
}

set.seed(42)
n_iter <- 100
mast_self <- numeric(n_iter)

for (i in 1:n_iter) {
  sampled_rows <- sample(1:nrow(matrix), size = nrow(matrix), replace = TRUE)
  boot_matrix <- matrix[sampled_rows, , drop = FALSE]
  rownames(boot_matrix) <- rownames(matrix)[sampled_rows]
  
  boot_phy <- phyDat(boot_matrix, type = "USER", levels = c(0, 1))
  tree_boot <- NJ(dist.hamming(boot_phy))
  tree_boot <- midpoint(tree_boot)
  
  common <- intersect(tree_boot$tip.label, tree_data$tip.label)
  if (length(common) >= 4) {
    mast_self[i] <- safe_mast_size(keep.tip(tree_boot, common),
                                   keep.tip(tree_data, common))
  } else {
    mast_self[i] <- NA
  }
  
  if (i %% 10 == 0) cat("Finished", i, "iterations\n")
}

valid_self <- mast_self[!is.na(mast_self)]

cat("Bootstrap vs. my cotton tree:\n")
cat("Mean:", mean(valid_self), "Min:", min(valid_self), "Max:", max(valid_self), "\n")

hist(valid_self, col = "red", main = "MAST size vs. my cotton tree",
     xlab = "Number of tips in MAST", breaks = 0:(max(valid_self)+1)-0.5)


