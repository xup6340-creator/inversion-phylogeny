score_cal <- function(tree_c, matrix) {
  n_cols <- ncol(matrix)
  score <- numeric(n_cols)
  for (i in seq_len(n_cols)) {
    single_col <- matrix[, i, drop = FALSE]
    single_data <- phyDat(single_col, type = "USER", levels = c(0, 1))
    score[i] <- parsimony(tree_c, single_data, method = "fitch")
  }
  return(score)
}

